#!/usr/bin/env bash
#
# cworktree — create a git worktree under <repo-root>/.claude/worktrees/<name>
#                   and optionally launch Claude Code or Codex in it.
#
# Works from anywhere inside a git repository (including from another worktree);
# worktrees are always created relative to the *main* repository root.
#
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 kxwild

set -euo pipefail

PROG=${0##*/}
DEFAULT_BASE_DIR=${CWORKTREE_DIR:-.claude/worktrees}
# Directory layout Claude Code itself uses; when the base dir matches it,
# `claude --worktree <name>` reuses the worktree created here instead of
# creating a second one. That only holds while both agree on which directory a
# name stands for: Claude Code keeps its worktrees *directly* under this
# directory, turning every '/' in the name into a '+' to get the single
# directory component, so we flatten names the same way (see wt_dir). A nested
# .claude/worktrees/feat/xy/x is invisible to it, and `claude --worktree
# feat/xy/x` would build a second worktree at .claude/worktrees/feat+xy+x.
CLAUDE_BASE_DIR=.claude/worktrees
# Longest name `claude --worktree` accepts.
CLAUDE_NAME_MAX=64
# Arguments to pass to `claude` when -c/--claude is given without any; nothing
# is passed by default.
DEFAULT_CLAUDE_ARGS=${CWORKTREE_CLAUDE_ARGS-}
# The same for `codex` and -x/--codex.
DEFAULT_CODEX_ARGS=${CWORKTREE_CODEX_ARGS-}
# codex takes the same five effort levels as claude, but as a config override
# rather than a flag of its own -- the one thing -x/--codex has to translate
# instead of passing through: --effort max becomes
# `-c model_reasoning_effort="max"`.
CODEX_EFFORT_KEY=model_reasoning_effort
# Prefix of the last stdout line when the shell wrapper asked for the session's
# command line instead of the session, i.e. --cd together with -c/--claude or
# -x/--codex: it has to cd first, so it evaluates the command itself.
LAUNCH_MARKER=__cworktree_launch__

if [ -t 2 ]; then
	C_RED=$'\033[31m'; C_YEL=$'\033[33m'; C_GRN=$'\033[32m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
else
	C_RED=; C_YEL=; C_GRN=; C_DIM=; C_OFF=
fi

die()  { printf '%s%s: %s%s\n' "$C_RED" "$PROG" "$*" "$C_OFF" >&2; exit 1; }
warn() { printf '%s%s: %s%s\n' "$C_YEL" "$PROG" "$*" "$C_OFF" >&2; }
info() { printf '%s%s%s\n' "$C_DIM" "$*" "$C_OFF" >&2; }
ok()   { printf '%s%s%s\n' "$C_GRN" "$*" "$C_OFF" >&2; }

usage() {
	cat <<EOF
Usage: $PROG [options] <new-branch-name> [<base-branch-name>|HEAD]
       $PROG --checkout <attached-branch-name> [options]
       $PROG <name>|.. --cd [-c|-x]
       $PROG [<name>...] -D|--delete [-f]
       $PROG -l|--list
       $PROG --shell-init [bash|zsh]

Create a git worktree at <repo-root>/$DEFAULT_BASE_DIR/<new-branch-name>,
with a new branch of that same name, from the given base branch -- a
commit, branch, tag or <remote>/<branch>, default HEAD. A worktree's
name is always its branch's; the two are never configured apart.
--checkout attaches an existing branch instead of creating one, named
the same way; --detach checks out a commit with no branch at all, so
the worktree's name is then just a name of its own.

A '/' in the name becomes a '+' in the directory rather than a
subdirectory -- the same mapping Claude Code applies, so that
\`claude --worktree feat/xy/x\` reuses our worktree instead of creating
a second one beside it. Only the directory is flattened; the branch
keeps its slashes.

Options may come before or after the branch name. --cd, -D/--delete and
--checkout take their name from the positional argument when it is not
given to the option itself, so \`$PROG fix-login --cd\` and
\`$PROG --cd fix-login\` mean the same thing -- likewise
\`$PROG --checkout feature/x\` and \`$PROG feature/x --checkout\`.
-D/--delete goes on taking names: every positional argument on the line
is one more worktree to remove.

Worktree:
  -B, --reset-branch    reset the branch to the base branch if it exists
      --checkout <name> attach an existing branch, create no new one
      --detach          detached HEAD at the start point, no branch
  -d, --dir <path>      base dir for worktrees, relative to the repo root
                        (default: $DEFAULT_BASE_DIR, env: CWORKTREE_DIR)
  -f, --force           pass --force to \`git worktree add\`, or to
                        \`git worktree remove\` with -D (twice if locked)
      --no-exclude      do not add the base dir to .git/info/exclude
      --no-fetch        do not auto-fetch when a remote branch is unknown

Agent session:
  -c, --claude [args]   after a successful create, run in this terminal:
                          claude --worktree <name> --name <name> [args]
                        naming the session after the worktree keeps
                        Claude Code from deleting it on a clean exit,
                        which is what an unnamed --worktree session does
                        by default. [args] is one string of extra claude
                        arguments, parsed like a shell command line, e.g.
                          -c '--chrome --dangerously-skip-permissions'
                        It is only taken as such when it starts with '-'
                        and is not a $PROG option; otherwise write
                        --claude=<args>. Omitted, \$CWORKTREE_CLAUDE_ARGS
                        is used instead.
  -x, --codex [args]    the same for Codex: cd into the worktree and run
                        \`codex [args]\` there. codex has no --worktree
                        aimed at an existing worktree -- its own makes a
                        new one -- so the session simply starts inside
                        ours. [args] works exactly like -c's, with
                        \$CWORKTREE_CODEX_ARGS as the default. Mutually
                        exclusive with -c/--claude
  -e, --effort <level>  pass --effort <level> to claude: low, medium,
                        high, xhigh, max -- each also its own flag,
                        --low ... --max. With -x/--codex the same five
                        levels go as \`-c $CODEX_EFFORT_KEY="<level>"\`,
                        which is how codex takes them. Implies a session,
                        -c/--claude unless -x/--codex says otherwise
      --                the rest, joined into one string, is the
                        session's [prompt]; implies a session too

Navigation and cleanup:
      --cd [name]       print an existing worktree's path, for the shell
                        wrapper to cd into; '..' is the repo root. With
                        -c/--claude or -x/--codex the shell cds there
                        first and starts the session afterwards
  -D, --delete [name...]
                        \`git worktree remove\` the worktree; -f if it is
                        dirty, -ff if it is locked. Several names remove
                        several worktrees: none goes until they all
                        resolve, and one that refuses does not stop the
                        others. Without a name, \`git worktree prune\`
                        instead
  -l, --list            list the worktrees under the base dir, one line each:
                        \`git log --oneline -1 --decorate\` of that worktree's
                        HEAD. A single worktree is shown as git itself would,
                        that same line followed by \`git status --short\`.
                        Piped or captured it prints bare names, one per line
      --shell-init [sh] print the shell wrapper -- which is what makes
                        --cd change directory -- plus tab completion;
                        [sh] is bash or zsh (default: from \$SHELL)

Other:
  -p, --path            print the worktree path on stdout and exit
  -n, --dry-run         show what would happen, change nothing
  -h, --help            show this help

Environment:
  CWORKTREE_CLAUDE_ARGS default claude arguments, for -c/--claude given
                        without [args] of its own, e.g. '--chrome'
  CWORKTREE_CODEX_ARGS  the same for -x/--codex, e.g. '--search'
  CWORKTREE_DIR         default base dir for worktrees (see -d/--dir)

Shell integration (a child cannot cd its parent, hence the wrapper):
  eval "\$($PROG --shell-init bash)"    # ~/.bashrc
  eval "\$($PROG --shell-init zsh)"     # ~/.zshrc, after compinit

Examples:
  $PROG fix-login                     # new branch from HEAD
  $PROG fix-login origin/main         # ... tracking origin/main
  $PROG hotfix v1.2.3 --detach        # detached at tag v1.2.3
  $PROG --checkout feature/x          # attach an existing branch
  $PROG fix-login -c '--chrome'       # claude, with --chrome
  $PROG fix-login --max               # claude at max effort
  $PROG fix-login -x                  # codex instead of claude
  $PROG fix-login -x --max            # ... at max effort
  $PROG fix-login -c -- fix the login # ... with a prompt
  $PROG fix-login --cd                # cd into the worktree
  $PROG fix-login --cd -c             # cd there, then claude
  $PROG --cd ..                       # cd back to the repo root
  $PROG fix-login -D                  # remove the worktree
  $PROG fix-login review -D           # ... or several at once
  $PROG -D                            # prune deleted worktrees
EOF
}

# ---------------------------------------------------------------- arguments --

NAME=
START_POINT=
CHECKOUT_TARGET=      # branch given directly to --checkout, see opt_arg
BASE_DIR=$DEFAULT_BASE_DIR
MODE=new            # new | checkout | detach
LAUNCH=0
AGENT=               # claude | codex: which one -c/--claude and -x/--codex run
RESET_BRANCH=0
FORCE=0              # -f/--force, counted: a second one reaches worktree remove
DO_EXCLUDE=1
DO_FETCH=1
PRINT_PATH=0
DRY_RUN=0
CD_TARGET=
DO_CD=0
WT_REL=              # worktree directory, relative to the base dir
WT_ABS=              # ... and absolute; both set by resolve_wt
CLAUDE_NAME=         # the name `claude --worktree` is given for it
CD_ONLY=0            # --cd to a worktree that is already there: create nothing
DO_LIST=0
DO_DELETE=0
DEL_TARGET=           # name given to -D/--delete itself
DEL_TARGETS=()        # every worktree -D/--delete was asked to remove
POS=()                # positional arguments, in order
SHELL_INIT=
EFFORT=              # claude --effort <level>, codex $CODEX_EFFORT_KEY
LAUNCH_ARGS=()       # from -c/-x, or $CWORKTREE_{CLAUDE,CODEX}_ARGS
LAUNCH_ARGS_SET=0
PROMPT=              # everything after --, one string: the session's [prompt]
SPLIT_ARGS=()
OPT_ARG=             # last optional option argument, see opt_arg

need_arg() { [ "$#" -ge 2 ] || die "option $1 requires an argument"; }

# Options whose argument may instead be given as the positional name (--cd,
# -D/--delete, --checkout) only take the next word when it cannot be an
# option of ours; the result is left in OPT_ARG.
opt_arg() {          # $1 = option, $2 = next word (if any)
	OPT_ARG=
	[ "$#" -ge 2 ] || return 1
	case $2 in
		''|-?*) return 1 ;;
	esac
	OPT_ARG=$2
}

check_name() {       # $1 = worktree name
	local seg rest
	case $1 in
		/*|-*)               die "invalid worktree name: $1" ;;
		*..*)                die "invalid worktree name: $1" ;;
		*[!A-Za-z0-9._+/-]*) die "invalid worktree name: $1 (allowed: A-Z a-z 0-9 . _ - + /)" ;;
	esac
	# '/' and '+' are one and the same separator once the name is flattened into
	# a directory name, so both delimit the segments checked here: none may be
	# empty -- which also rules out a leading, trailing or doubled separator --
	# and none may name something git owns. What is left is exactly what
	# `claude --worktree` accepts, so the two never disagree about a name.
	rest=${1//+//}
	while :; do
		seg=${rest%%/*}
		case $seg in
			'') die "invalid worktree name: $1 (empty path segment)" ;;
			.)  die "invalid worktree name: $1 ('.' path segment)" ;;
			[.][Gg][Ii][Tt]|[.][Gg][Ii][Tt].)
				die "invalid worktree name: $1 ('$seg' is a reserved git directory name)" ;;
		esac
		case $rest in
			*/*) rest=${rest#*/} ;;
			*)   break ;;
		esac
	done
}

# The one directory component a worktree name stands for under the base dir.
# Claude Code makes one out of a `--worktree` name by replacing every '/' with
# a '+', and looks for worktrees directly under .claude/worktrees/ only, so the
# same mapping here is what lets it reuse ours instead of creating its own.
wt_dir() {           # $1 = worktree name
	printf '%s' "${1//\//+}"
}

# Print the arguments quoted for a shell to read back, for the launch command
# handed to the --shell-init wrapper.
shq() {
	local arg out= q=\' esc=\'\\\'\'
	for arg in "$@"; do
		arg=${arg//$q/$esc}
		out="$out '$arg'"
	done
	printf '%s' "${out# }"
}

# Split $1 into words the way a shell would — quoting is honoured, filename
# globbing is not — and leave the result in SPLIT_ARGS.
shell_split() {
	local rc=0
	SPLIT_ARGS=()
	set -f
	eval "SPLIT_ARGS=($1)" 2>/dev/null || rc=$?
	set +f
	return "$rc"
}

add_launch_args() {  # $1 = string of agent arguments, $2 = source, for errors
	shell_split "$1" || die "cannot parse $2: $1"
	LAUNCH_ARGS_SET=1
	[ "${#SPLIT_ARGS[@]}" -eq 0 ] || LAUNCH_ARGS+=("${SPLIT_ARGS[@]}")
}

# An effort level is only useful together with a session, so asking for one asks
# for a session too; which program runs it stays -c/--claude's or -x/--codex's
# to say, on either side of this on the line.
set_effort() {       # $1 = effort level
	case $1 in
		low|medium|high|xhigh|max) ;;
		*) die "invalid effort level: $1 (low, medium, high, xhigh, max)" ;;
	esac
	EFFORT=$1
	LAUNCH=1
}

# One terminal runs one session, so -c/--claude and -x/--codex name the program
# that gets it rather than adding to a list: the second one on the line is a
# mistake, not a change of mind.
set_agent() {        # $1 = claude | codex
	if [ -n "$AGENT" ] && [ "$AGENT" != "$1" ]; then
		die "-c/--claude and -x/--codex are mutually exclusive"
	fi
	AGENT=$1
	LAUNCH=1
}

# The argument of -c/--claude and -x/--codex is optional, so only take the next
# word when it can only have been meant for the session: option-looking, and
# none of ours.
is_agent_args() {
	case $1 in
		-h|--help|-c|--claude|-x|--codex|-e|--effort|--low|--medium|--high|--xhigh|--max\
		|-B|--reset-branch|--checkout\
		|--detach|-f|--force|-d|--dir|--no-exclude|--no-fetch|-p|--path\
		|--cd|-D|--delete|-l|--list|--shell-init|-n|--dry-run|--) return 1 ;;
		--claude=*|--codex=*|--effort=*|--checkout=*|--dir=*|--cd=*|--delete=*|--shell-init=*) return 1 ;;
		-?*) return 0 ;;
		*) return 1 ;;
	esac
}

while [ "$#" -gt 0 ]; do
	case $1 in
		-h|--help)          usage; exit 0 ;;
		-c|--claude)
			set_agent claude
			if [ "$#" -ge 2 ] && is_agent_args "$2"; then
				add_launch_args "$2" "claude arguments"; shift
			fi
			;;
		--claude=*)         set_agent claude; add_launch_args "${1#*=}" "claude arguments" ;;
		-x|--codex)
			set_agent codex
			if [ "$#" -ge 2 ] && is_agent_args "$2"; then
				add_launch_args "$2" "codex arguments"; shift
			fi
			;;
		--codex=*)          set_agent codex; add_launch_args "${1#*=}" "codex arguments" ;;
		-e|--effort)        need_arg "$@"; set_effort "$2"; shift ;;
		--effort=*)         set_effort "${1#*=}" ;;
		--low|--medium|--high|--xhigh|--max) set_effort "${1#--}" ;;
		-B|--reset-branch)  RESET_BRANCH=1 ;;
		--checkout)         MODE=checkout; if opt_arg "$@"; then CHECKOUT_TARGET=$OPT_ARG; shift; fi ;;
		--checkout=*)       MODE=checkout; CHECKOUT_TARGET=${1#*=} ;;
		--detach)           MODE=detach ;;
		-f|--force)         FORCE=$((FORCE + 1)) ;;
		-d|--dir)           need_arg "$@"; BASE_DIR=$2; shift ;;
		--dir=*)            BASE_DIR=${1#*=} ;;
		--no-exclude)       DO_EXCLUDE=0 ;;
		--no-fetch)         DO_FETCH=0 ;;
		-p|--path)          PRINT_PATH=1 ;;
		--cd)               DO_CD=1; if opt_arg "$@"; then CD_TARGET=$OPT_ARG; shift; fi ;;
		--cd=*)             DO_CD=1; CD_TARGET=${1#*=} ;;
		-D|--delete)        DO_DELETE=1; if opt_arg "$@"; then DEL_TARGET=$OPT_ARG; shift; fi ;;
		--delete=*)         DO_DELETE=1; DEL_TARGET=${1#*=} ;;
		-l|--list)          DO_LIST=1 ;;
		--shell-init)       # the shell name is optional
			SHELL_INIT=auto
			case ${2-} in bash|zsh|sh) SHELL_INIT=$2; shift ;; esac
			;;
		--shell-init=*)     SHELL_INIT=${1#*=} ;;
		-n|--dry-run)       DRY_RUN=1 ;;
		--)                 # the rest is the session's [prompt], as one argument
			shift
			if [ "$#" -gt 0 ]; then PROMPT=$*; LAUNCH=1; fi
			break
			;;
		-*)                 die "unknown option: $1 (try --help)" ;;
		*)                  POS+=("$1") ;;
	esac
	shift
done

# What the positional arguments mean depends on the mode, so they are only
# sorted out once the whole line has been read: -D/--delete takes any number
# of worktree names; --checkout takes the one branch to attach, from its own
# argument or the sole positional; everything else a new branch name and a
# base branch.
if [ "$DO_DELETE" -eq 1 ]; then
	[ -z "$DEL_TARGET" ] || DEL_TARGETS=("$DEL_TARGET")
	[ "${#POS[@]}" -eq 0 ] || DEL_TARGETS+=("${POS[@]}")
elif [ "$MODE" = checkout ]; then
	[ "${#POS[@]}" -le 1 ] || die "unexpected argument: ${POS[1]} (try --help)"
	NAME=${POS[0]-}
	if [ -n "$CHECKOUT_TARGET" ]; then
		[ -z "$NAME" ] || [ "$NAME" = "$CHECKOUT_TARGET" ] ||
			die "conflicting branch names: $CHECKOUT_TARGET and $NAME"
		NAME=$CHECKOUT_TARGET
	fi
else
	[ "${#POS[@]}" -le 2 ] || die "unexpected argument: ${POS[2]} (try --help)"
	NAME=${POS[0]-}
	START_POINT=${POS[1]-}
fi

# -e/--effort and -- ask for a session without saying whose; claude's, then.
[ "$LAUNCH" -eq 0 ] || [ -n "$AGENT" ] || AGENT=claude

# -c/--claude or -x/--codex without arguments of its own falls back to the
# environment -- to its own variable, so both can be set at once.
if [ "$LAUNCH" -eq 1 ] && [ "$LAUNCH_ARGS_SET" -eq 0 ]; then
	if [ "$AGENT" = codex ]; then
		add_launch_args "$DEFAULT_CODEX_ARGS" '$CWORKTREE_CODEX_ARGS'
	else
		add_launch_args "$DEFAULT_CLAUDE_ARGS" '$CWORKTREE_CLAUDE_ARGS'
	fi
fi

# Only the shell itself can change its directory, so --cd with a session is a
# two-step affair: the wrapper sets this, we print the session's command line
# instead of running it, and the wrapper evaluates it after the cd.
DEFER_LAUNCH=0
if [ "${CWORKTREE_DEFER_LAUNCH-}" = 1 ] && [ "$DO_CD" -eq 1 ] && [ "$LAUNCH" -eq 1 ]; then
	DEFER_LAUNCH=1
fi

# --cd alone only navigates and never creates anything (a typo should not leave
# a worktree behind); asking for a session, or for anything about the branch,
# means the worktree may be created on the way.
CREATE_INTENT=0
if [ "$LAUNCH" -eq 1 ] || [ -n "$START_POINT" ] \
	|| [ "$MODE" != new ] || [ "$RESET_BRANCH" -eq 1 ]; then
	CREATE_INTENT=1
fi

# --------------------------------------------------------- shell integration --

# Emitted for `eval "$(cworktree --shell-init)"`: a wrapper function (a child
# process cannot change its parent's directory, so --cd only prints the path and
# the wrapper does the cd) plus tab completion.
shell_init() {
	local shell=$1 self=$SELF quoted
	if [ "$shell" = auto ]; then
		local login_shell=${SHELL-}
		case ${login_shell##*/} in
			zsh) shell=zsh ;;
			*)   shell=bash ;;
		esac
	fi
	quoted=${self//\'/\'\\\'\'}

	cat <<-EOF
		__cworktree_bin='$quoted'
		__cworktree_launch='$LAUNCH_MARKER'

		cworktree() {
		  local __cw_arg __cw_prev= __cw_cd=0 __cw_run=0 __cw_out __cw_last __cw_cmd=
		  for __cw_arg in "\$@"; do
		    # skip the value of options that take one, so \`-d --cd\` is a directory named --cd
		    case \$__cw_prev in
		      -d|--dir|-e|--effort) __cw_prev=\$__cw_arg; continue ;;
		    esac
		    case \$__cw_arg in
		      --) __cw_run=1; break ;;
		      --cd|--cd=*) __cw_cd=1 ;;
		      -c|--claude|--claude=*|-x|--codex|--codex=*) __cw_run=1 ;;
		      -e|--effort|--effort=*|--low|--medium|--high|--xhigh|--max) __cw_run=1 ;;
		    esac
		    __cw_prev=\$__cw_arg
		  done
		  if [ "\$__cw_cd" -eq 0 ]; then
		    "\$__cworktree_bin" "\$@"
		    return \$?
		  fi
		  # --cd asking for a session too: take the command line, cd, run it.
		  if [ "\$__cw_run" -eq 1 ]; then
		    __cw_out=\$(CWORKTREE_DEFER_LAUNCH=1 "\$__cworktree_bin" "\$@") || return \$?
		  else
		    __cw_out=\$("\$__cworktree_bin" "\$@") || return \$?
		  fi
		  [ -n "\$__cw_out" ] || return 1
		  __cw_last=\${__cw_out##*\$'\n'}
		  case \$__cw_last in
		    "\$__cworktree_launch "*)
		      case \$__cw_out in
		        *\$'\n'*)
		          __cw_cmd=\${__cw_last#\$__cworktree_launch }
		          __cw_out=\${__cw_out%\$'\n'*}
		          ;;
		      esac
		      ;;
		  esac
		  cd -- "\${__cw_out##*\$'\n'}" || return \$?
		  [ -n "\$__cw_cmd" ] || return 0
		  eval "\$__cw_cmd"
		}
	EOF

	if [ "$shell" = zsh ]; then
		cat <<-'EOF'

			__cworktree_names() {
			  local -a n
			  n=(${(f)"$("$__cworktree_bin" --list 2>/dev/null)"})
			  print -r -- ${(F)${n:#}}
			}

			_cworktree() {
			  local cur=${words[CURRENT]} prev=${words[CURRENT-1]}
			  local -a cands
			  # -D/--delete takes any number of names, so once it is on the line
			  # every positional completes to a worktree rather than to a branch.
			  local i del=0
			  for (( i = 1; i < CURRENT; i++ )); do
			    case ${words[i]} in -D|--delete|--delete=*) del=1 ;; esac
			  done
			  if [[ $cur == --cd=* ]]; then
			    compset -P '--cd='
			    cands=(.. ${(f)"$(__cworktree_names)"})
			    compadd -a cands
			    return
			  fi
			  if [[ $cur == --delete=* ]]; then
			    compset -P '--delete='
			    cands=(${(f)"$(__cworktree_names)"})
			    compadd -a cands
			    return
			  fi
			  if [[ $cur == --effort=* ]]; then
			    compset -P '--effort='
			    compadd low medium high xhigh max
			    return
			  fi
			  if [[ $cur == --checkout=* ]]; then
			    compset -P '--checkout='
			    cands=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"})
			    compadd -a cands
			    return
			  fi
			  case $prev in
			    --cd)
			      cands=(.. ${(f)"$(__cworktree_names)"})
			      compadd -a cands; return ;;
			    -e|--effort)
			      compadd low medium high xhigh max; return ;;
			    --checkout)
			      cands=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"})
			      compadd -a cands; return ;;
			    -d|--dir)   _files -/; return ;;
			    --shell-init) compadd bash zsh; return ;;
			  esac
			  if [[ $cur == -* ]]; then
			    cands=(-c --claude -x --codex -e --effort --low --medium --high --xhigh --max
			           -B --reset-branch --checkout --detach
			           -f --force -d --dir --no-exclude --no-fetch -p --path
			           --cd -D --delete -l --list --shell-init -n --dry-run -h --help)
			    compadd -a cands; return
			  fi
			  if (( del )); then
			    cands=(${(f)"$(__cworktree_names)"})
			    compadd -a cands; return
			  fi
			  cands=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes refs/tags 2>/dev/null)"})
			  compadd -a cands
			}

			(( $+functions[compdef] )) && compdef _cworktree cworktree
		EOF
	else
		cat <<-'EOF'

			_cworktree() {
			  local cur prev names opts i del=0
			  COMPREPLY=()
			  cur=${COMP_WORDS[COMP_CWORD]}
			  prev=${COMP_WORDS[COMP_CWORD-1]}
			  # -D/--delete takes any number of names, so once it is on the line
			  # every positional completes to a worktree rather than to a branch.
			  for (( i = 1; i < COMP_CWORD; i++ )); do
			    case ${COMP_WORDS[i]} in -D|--delete|--delete=*) del=1 ;; esac
			  done
			  opts='-c --claude -x --codex -e --effort --low --medium --high --xhigh --max
			        -B --reset-branch --checkout --detach
			        -f --force -d --dir --no-exclude --no-fetch -p --path
			        --cd -D --delete -l --list --shell-init -n --dry-run -h --help'
			  case $cur in
			    --cd=*)
			      names=$("$__cworktree_bin" --list 2>/dev/null)
			      COMPREPLY=( $(compgen -P '--cd=' -W ".. $names" -- "${cur#--cd=}") )
			      return 0 ;;
			    --delete=*)
			      names=$("$__cworktree_bin" --list 2>/dev/null)
			      COMPREPLY=( $(compgen -P '--delete=' -W "$names" -- "${cur#--delete=}") )
			      return 0 ;;
			    --effort=*)
			      COMPREPLY=( $(compgen -P '--effort=' -W 'low medium high xhigh max' -- "${cur#--effort=}") )
			      return 0 ;;
			    --checkout=*)
			      COMPREPLY=( $(compgen -P '--checkout=' -W "$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)" -- "${cur#--checkout=}") )
			      return 0 ;;
			  esac
			  case $prev in
			    --cd)
			      names=$("$__cworktree_bin" --list 2>/dev/null)
			      COMPREPLY=( $(compgen -W ".. $names" -- "$cur") )
			      return 0 ;;
			    -e|--effort)
			      COMPREPLY=( $(compgen -W 'low medium high xhigh max' -- "$cur") )
			      return 0 ;;
			    --checkout)
			      COMPREPLY=( $(compgen -W "$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)" -- "$cur") )
			      return 0 ;;
			    -d|--dir)
			      COMPREPLY=( $(compgen -d -- "$cur") )
			      return 0 ;;
			    --shell-init)
			      COMPREPLY=( $(compgen -W 'bash zsh' -- "$cur") )
			      return 0 ;;
			  esac
			  if [[ $cur == -* ]]; then
			    COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
			    return 0
			  fi
			  if [ "$del" -eq 1 ]; then
			    names=$("$__cworktree_bin" --list 2>/dev/null)
			    COMPREPLY=( $(compgen -W "$names" -- "$cur") )
			    return 0
			  fi
			  COMPREPLY=( $(compgen -W "$(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes refs/tags 2>/dev/null)" -- "$cur") )
			}

			complete -F _cworktree cworktree
		EOF
	fi
}

if [ -n "$SHELL_INIT" ]; then
	case $SHELL_INIT in
		auto|bash|zsh|sh) ;;
		*) die "--shell-init: unsupported shell: $SHELL_INIT (bash or zsh)" ;;
	esac
	[ "$SHELL_INIT" != sh ] || SHELL_INIT=bash
	# Resolve this script to an absolute path so the wrapper works without $PATH.
	SELF=$0
	case $SELF in
		*/*) ;;
		*) SELF=$(command -v -- "$SELF" 2>/dev/null || printf '%s' "$SELF") ;;
	esac
	case $SELF in
		*/*) SELF=$(cd "${SELF%/*}" && pwd)/${SELF##*/} ;;
	esac
	shell_init "$SHELL_INIT"
	exit 0
fi

# ------------------------------------------------------------- mode checks ---

if [ "$DO_LIST" -eq 1 ] || [ "$DO_DELETE" -eq 1 ]; then
	[ "$DO_LIST" -eq 0 ] || [ "$DO_DELETE" -eq 0 ] || die "--list and --delete are mutually exclusive"
	[ "$DO_CD" -eq 0 ] || die "--cd cannot be combined with --list or --delete"
	[ "$LAUNCH" -eq 0 ] || die "-c/--claude and -x/--codex cannot be combined with --list or --delete"
	[ "$PRINT_PATH" -eq 0 ] || die "-p/--path cannot be combined with --list or --delete"
fi

# --cd and -D/--delete name a worktree; the name may be given to the option or,
# with the option trailing, as the positional argument.
if [ "$DO_CD" -eq 1 ]; then
	if [ -z "$CD_TARGET" ]; then
		CD_TARGET=$NAME
		[ -n "$CD_TARGET" ] || die "--cd requires a worktree name (or '..' for the repo root)"
	fi
	case $CD_TARGET in
		.|..)
			# The repo root is not a worktree of ours: nothing to create.
			CD_ONLY=1
			# With the option trailing, '..' is the positional argument itself.
			[ -z "$NAME" ] || [ "$NAME" = "$CD_TARGET" ] ||
				die "unexpected argument: $NAME (try --help)"
			[ -z "$START_POINT" ] || die "unexpected argument: $START_POINT (try --help)"
			;;
		*)
			check_name "$CD_TARGET"
			if [ -z "$NAME" ]; then
				NAME=$CD_TARGET
			elif [ "$NAME" != "$CD_TARGET" ]; then
				die "conflicting worktree names: $CD_TARGET and $NAME"
			fi
			;;
	esac
fi

if [ "$DO_DELETE" -eq 1 ]; then
	if [ "${#DEL_TARGETS[@]}" -gt 0 ]; then
		for del_name in "${DEL_TARGETS[@]}"; do
			check_name "$del_name"
		done
	fi
elif [ "$DO_LIST" -eq 1 ]; then
	[ -z "$NAME" ] || die "unexpected argument: $NAME (--list takes none)"
elif [ "$CD_ONLY" -eq 0 ]; then
	[ -n "$NAME" ] || { usage >&2; exit 2; }
	check_name "$NAME"
fi

# ------------------------------------------------------------ repo location --

git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"

# --git-common-dir points at the main repo's .git even when run from a worktree.
COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
	|| COMMON_DIR=$(cd "$(git rev-parse --git-common-dir)" && pwd)
[ -n "$COMMON_DIR" ] || die "cannot locate the repository"
[ "$(git rev-parse --is-bare-repository)" = false ] || die "bare repositories are not supported"
REPO_ROOT=$(dirname "$COMMON_DIR")

BASE_DIR=${BASE_DIR%/}
case $BASE_DIR in /*) die "--dir must be relative to the repo root: $BASE_DIR" ;; esac

# ------------------------------------------- list / delete / --cd / claude ---

# Where the worktree called $1 is, or goes: <base-dir>/<flattened name>, left in
# WT_REL (relative to the base dir) and WT_ABS.
resolve_wt() {           # $1 = worktree name
	local flat
	flat=$(wt_dir "$1")
	WT_REL=$flat
	# --list prints directory names, so one that already is a directory wins over
	# its flattened form: with a feat+xy+x next to it, spelling out feat/xy/x is
	# the only way left to reach a feat/xy/x worktree that an older cworktree
	# nested, whether to cd into it or to remove it.
	[ "$flat" = "$1" ] || ! worktree_registered "$REPO_ROOT/$BASE_DIR/$1" || WT_REL=$1
	WT_ABS=$REPO_ROOT/$BASE_DIR/$WT_REL
}

# Names of the registered worktrees living under <repo-root>/<base-dir>/.
list_worktree_names() {
	local prefix=$REPO_ROOT/$BASE_DIR/ key value
	git -C "$REPO_ROOT" worktree list --porcelain | while read -r key value; do
		[ "$key" = worktree ] || continue
		case $value in
			"$prefix"?*) printf '%s\n' "${value#"$prefix"}" ;;
		esac
	done | LC_ALL=C sort
}

# Context for the 'no such worktree' errors below.
# "<name>\t<HEAD sha>" for every worktree under the base dir, sorted by name.
list_worktree_heads() {
	local prefix=$REPO_ROOT/$BASE_DIR/ key value name=
	git -C "$REPO_ROOT" worktree list --porcelain | while read -r key value; do
		case $key in
			worktree)
				name=
				case $value in "$prefix"?*) name=${value#"$prefix"} ;; esac
				;;
			HEAD)
				[ -z "$name" ] || printf '%s\t%s\n' "$name" "$value"
				name=
				;;
		esac
	done | LC_ALL=C sort
}

# A lone worktree needs no name column, so git speaks for itself: `git log
# --oneline -1` of its HEAD followed by `git status --short`, written straight to
# our stdout. This path is terminal-only, so git's own colours and its
# `(HEAD -> main)` ref decoration come through as if it had been run by hand.
list_worktree_single() {   # $1 = worktree path, $2 = name, $3 = HEAD sha
	# --no-pager throughout: this writes to a terminal, which is exactly when git
	# would otherwise hand a one-line log to a pager.
	if [ -d "$1" ]; then
		git --no-pager -C "$1" log --oneline -1 --decorate 2>/dev/null || :
		git --no-pager -C "$1" status --short 2>/dev/null || :
		return 0
	fi
	# Registered, but the directory is gone: the main repo still knows the commit.
	git --no-pager -C "$REPO_ROOT" log --oneline -1 --decorate "$3" 2>/dev/null || :
	printf '(missing) %s\n' "$BASE_DIR/$2"
}

# The same names with `git log --oneline -1` of each alongside, for a human at a
# terminal: the abbreviated hash and the subject, aligned on the longest name and
# truncated to the terminal width. The commit is read from the main repo, so a
# worktree whose directory has been deleted by hand still gets its line. One line
# per worktree -- except when there is only one, which also gets its
# `git status --short` underneath.
list_worktrees_long() {
	local heads name sha path line short deco rest subject
	local width=0 count=0 avail room cols
	local dim= yel= cya= off=
	heads=$(list_worktree_heads)
	[ -n "$heads" ] || return 0
	while IFS= read -r line; do count=$((count + 1)); done <<< "$heads"
	if [ "$count" -eq 1 ]; then
		name=${heads%%$'\t'*}
		sha=${heads#*$'\t'}
		list_worktree_single "$REPO_ROOT/$BASE_DIR/$name" "$name" "$sha"
		return 0
	fi
	if [ -t 1 ]; then
		dim=$'\033[2m'; yel=$'\033[33m'; cya=$'\033[36m'; off=$'\033[0m'
	fi
	while IFS=$'\t' read -r name sha; do
		[ "${#name}" -le "$width" ] || width=${#name}
	done <<< "$heads"
	cols=${COLUMNS:-}
	[ -n "$cols" ] || cols=$(tput cols 2>/dev/null) || cols=
	case $cols in ''|*[!0-9]*) cols=80 ;; esac
	avail=$((cols - width - 2))
	while IFS=$'\t' read -r name sha; do
		# '%h%d %s' is what `--oneline --decorate` prints. The three fields come
		# back tab-separated so each can be coloured on its own and the subject
		# shortened without touching the hash or the ref names. Read from inside
		# the worktree, because that is what makes the decoration say
		# '(HEAD -> <its branch>)' rather than the main repo's.
		path=$REPO_ROOT/$BASE_DIR/$name
		if [ -d "$path" ]; then
			line=$(git --no-pager -C "$path" log -1 --format='%h%x09%d%x09%s' 2>/dev/null) || line=
		else
			line=$(git --no-pager -C "$REPO_ROOT" log -1 --format='%h%x09%d%x09%s' "$sha" 2>/dev/null) || line=
		fi
		if [ -z "$line" ]; then
			printf '%s\n' "$name"
			continue
		fi
		short=${line%%$'\t'*}
		rest=${line#*$'\t'}
		deco=${rest%%$'\t'*}
		subject=${rest#*$'\t'}
		# Only the subject is shortened; the hash and the ref names have to stay
		# whole. Never below a floor: with very long names a slight overflow beats
		# letting an unbounded subject wrap over several lines.
		room=$((avail - ${#short} - ${#deco} - 1))
		[ "$room" -ge 20 ] || room=20
		if [ "${#subject}" -gt "$room" ]; then
			subject=${subject:0:$((room - 3))}...
		fi
		# %d already carries its own leading space and parentheses, or is empty.
		if [ -n "$subject" ]; then
			printf '%-*s  %s%s%s%s%s%s %s%s%s\n' "$width" "$name" \
				"$yel" "$short" "$off" "$cya" "$deco" "$off" "$dim" "$subject" "$off"
		else
			printf '%-*s  %s%s%s%s%s%s\n' "$width" "$name" \
				"$yel" "$short" "$off" "$cya" "$deco" "$off"
		fi
	done <<< "$heads"
}

known_worktrees() {
	local names
	names=$(list_worktree_names)
	[ -z "$names" ] || info "known worktrees: $(printf '%s' "$names" | tr '\n' ' ')"
}

worktree_registered() {  # $1 = absolute path
	git -C "$REPO_ROOT" worktree list --porcelain | grep -Fxq "worktree $1"
}
branch_in_use() {        # $1 = branch name
	git -C "$REPO_ROOT" worktree list --porcelain | grep -Fxq "branch refs/heads/$1"
}
branch_exists() {        # $1 = branch name
	git show-ref --verify --quiet "refs/heads/$1"
}

# The name to hand `claude --worktree` for the worktree at WT_REL, left in
# CLAUDE_NAME. Claude Code flattens '/' to '+' to get the directory, so every
# name that flattens to WT_REL reaches it -- and as it rejects a '+' in a name
# of its own, that is WT_REL read back the other way round. Fails, with the
# reason, whenever Claude Code would instead land somewhere else and build a
# second worktree there.
claude_worktree_name() {
	CLAUDE_NAME=${WT_REL//+//}
	if [ "$BASE_DIR" != "$CLAUDE_BASE_DIR" ]; then
		warn "base dir is not $CLAUDE_BASE_DIR; starting claude inside the worktree instead of with --worktree"
		return 1
	fi
	case $WT_REL in
		*/*)
			warn "$WT_REL is nested under $BASE_DIR/, where claude --worktree cannot see it; starting claude inside the worktree instead"
			info "  it predates the flat layout: \`$PROG '$WT_REL' -D\` removes it, then create it again to get one claude can reuse"
			return 1
			;;
	esac
	if [ "${#CLAUDE_NAME}" -gt "$CLAUDE_NAME_MAX" ]; then
		warn "the name is longer than the $CLAUDE_NAME_MAX characters claude --worktree accepts; starting claude inside the worktree instead"
		return 1
	fi
	return 0
}

# Build the session's command line for the worktree at $1 and run it — or, when
# the shell wrapper has to cd first (--cd together with -c/--claude or
# -x/--codex), print it for the wrapper to evaluate once it has.
launch_agent() {         # $1 = worktree path, or the repo root for '--cd ..'
	local wt_path=$1 cwd
	command -v "$AGENT" >/dev/null 2>&1 || die "$AGENT not found in PATH"

	if [ "$AGENT" = codex ]; then
		# codex has no --worktree to aim at a worktree that is already there --
		# its own always makes a new one -- so the session just starts inside
		# ours, which is also what makes `codex resume` find it again: its picker
		# filters by the directory the session ran in.
		CMD=(codex)
		cwd=$wt_path
		# The same five levels as claude's --effort, but codex takes them as a
		# config override rather than a flag of its own.
		[ -z "$EFFORT" ] || CMD+=(-c "$CODEX_EFFORT_KEY=\"$EFFORT\"")
	else
		if [ "$wt_path" = "$REPO_ROOT" ]; then
			# '--cd ..': no worktree involved, just a session at the top.
			CMD=(claude)
			cwd=$REPO_ROOT
		elif claude_worktree_name; then
			# Claude Code resolves this name to exactly the worktree we have, so it
			# reuses the one just created rather than making another. An unnamed
			# --worktree session is auto-deleted, worktree and branch both, when a
			# clean exit finds nothing worth keeping; naming the session after the
			# same worktree turns that into a prompt instead.
			CMD=(claude --worktree "$CLAUDE_NAME" --name "$CLAUDE_NAME")
			cwd=$REPO_ROOT
		else
			CMD=(claude)
			cwd=$wt_path
		fi
		[ -z "$EFFORT" ] || CMD+=(--effort "$EFFORT")
	fi
	[ "${#LAUNCH_ARGS[@]}" -eq 0 ] || CMD+=("${LAUNCH_ARGS[@]}")
	# Everything after '--' is a single argument: the session's [prompt], which
	# claude and codex both take as their trailing positional.
	[ -z "$PROMPT" ] || CMD+=("$PROMPT")

	info "+ ${CMD[*]}"
	[ "$DRY_RUN" -eq 0 ] || exit 0
	if [ "$DEFER_LAUNCH" -eq 1 ]; then
		# The wrapper cds into the path printed above and evaluates this; the
		# subshell keeps our own cd out of the shell it just moved.
		printf '%s ( cd %s && exec %s )\n' "$LAUNCH_MARKER" "$(shq "$cwd")" "$(shq "${CMD[@]}")"
		exit 0
	fi
	[ "$DO_CD" -eq 0 ] || info "run \`eval \"\$($PROG --shell-init)\"\` to have --cd move your shell as well"
	# Do not let the wrapper protocol leak into a cworktree run inside the session.
	unset CWORKTREE_DEFER_LAUNCH
	cd "$cwd"
	exec "${CMD[@]}"
}

if [ "$DO_LIST" -eq 1 ]; then
	# Only a human gets the commit subjects: the shell completion parses this
	# output, so a pipe or a command substitution still sees bare names.
	if [ -t 1 ]; then
		list_worktrees_long
	else
		list_worktree_names
	fi
	exit 0
fi

if [ "$DO_DELETE" -eq 1 ]; then
	if [ "${#DEL_TARGETS[@]}" -eq 0 ]; then
		# No name: only clean up after worktrees whose directory is gone.
		CMD=(git -C "$REPO_ROOT" worktree prune --verbose)
		[ "$DRY_RUN" -eq 0 ] || CMD+=(--dry-run)
		info "+ ${CMD[*]}"
		"${CMD[@]}"
		exit 0
	fi
	# Every name is resolved and vetted before the first worktree goes, so a typo
	# at the end of the list does not remove the beginning of it first.
	DEL_PATHS=()
	DEL_RELS=()
	for del_name in "${DEL_TARGETS[@]}"; do
		resolve_wt "$del_name"
		if ! worktree_registered "$WT_ABS"; then
			known_worktrees
			die "no such worktree: $del_name (under $BASE_DIR/)"
		fi
		# git refuses to remove the worktree it runs in; catch the same mistake
		# early, whatever directory git itself is invoked from.
		case $PWD/ in
			"$WT_ABS"/*) die "you are inside $del_name; cd out of it first (e.g. \`$PROG --cd ..\`)" ;;
		esac
		# One worktree named twice -- or once by name and once already flattened --
		# is removed once; the second `git worktree remove` would only fail.
		del_dup=0
		for del_seen in ${DEL_PATHS[@]+"${DEL_PATHS[@]}"}; do
			[ "$del_seen" != "$WT_ABS" ] || { del_dup=1; break; }
		done
		if [ "$del_dup" -eq 0 ]; then
			DEL_PATHS+=("$WT_ABS")
			DEL_RELS+=("$WT_REL")
		fi
	done
	DEL_FAILED=0
	del_i=0
	while [ "$del_i" -lt "${#DEL_PATHS[@]}" ]; do
		DEL_PATH=${DEL_PATHS[$del_i]}
		DEL_REL=${DEL_RELS[$del_i]}
		del_i=$((del_i + 1))
		CMD=(git -C "$REPO_ROOT" worktree remove)
		# One --force removes a dirty worktree, a second one a locked worktree.
		[ "$FORCE" -lt 1 ] || CMD+=(--force)
		[ "$FORCE" -lt 2 ] || CMD+=(--force)
		CMD+=("$DEL_PATH")
		info "+ ${CMD[*]}"
		[ "$DRY_RUN" -eq 0 ] || continue
		# One worktree refusing to go -- dirty, locked -- does not hold up the
		# rest of the list; the exit status still reports it.
		if ! "${CMD[@]}"; then
			DEL_FAILED=$((DEL_FAILED + 1))
			continue
		fi
		ok "worktree removed: $DEL_PATH"
		# `git worktree remove` takes the leaf only, so a name that an older
		# cworktree nested leaves its parent directories behind empty. Tidy those
		# away as far up as the base dir; rmdir stops at the first one still
		# holding something.
		while [ "${DEL_REL%/*}" != "$DEL_REL" ]; do
			DEL_REL=${DEL_REL%/*}
			rmdir "$REPO_ROOT/$BASE_DIR/$DEL_REL" 2>/dev/null || break
		done
	done
	[ "$DEL_FAILED" -eq 0 ] ||
		die "$DEL_FAILED of ${#DEL_PATHS[@]} worktrees could not be removed"
	exit 0
fi

# A --cd to a worktree that is already there leaves it alone; one to a worktree
# that is not only creates it when a create or a session was asked for too.
if [ "$DO_CD" -eq 1 ] && [ "$CD_ONLY" -eq 0 ]; then
	resolve_wt "$NAME"
	if [ -d "$WT_ABS" ] || [ "$CREATE_INTENT" -eq 0 ]; then
		CD_ONLY=1
	fi
fi

if [ "$CD_ONLY" -eq 1 ]; then
	case $CD_TARGET in
		.|..) CD_PATH=$REPO_ROOT ;;
		*)
			resolve_wt "$CD_TARGET"
			CD_PATH=$WT_ABS
			if [ ! -d "$CD_PATH" ]; then
				known_worktrees
				die "no such worktree: $CD_TARGET (under $BASE_DIR/)"
			fi
			;;
	esac
	# Only the path goes to stdout: the shell wrapper cds into it.
	printf '%s\n' "$CD_PATH"
	[ "$LAUNCH" -eq 0 ] || launch_agent "$CD_PATH"
	[ -t 1 ] || exit 0
	info "run \`eval \"\$($PROG --shell-init)\"\` to make --cd change directory"
	exit 0
fi

resolve_wt "$NAME"
WT_PATH=$WT_ABS

if [ "$PRINT_PATH" -eq 1 ]; then
	printf '%s\n' "$WT_PATH"
	exit 0
fi

# ------------------------------------------------------------- start point ---

# --checkout attaches an existing branch as-is: there is no base branch to
# resolve, and $NAME -- the branch itself -- is checked in the build step below.
if [ "$MODE" != checkout ]; then
	START_POINT=${START_POINT:-HEAD}

	resolve() { git rev-parse --verify --quiet "$1^{commit}" >/dev/null 2>&1; }

	if ! resolve "$START_POINT"; then
		# Unknown ref: if it looks like <known-remote>/<branch>, try fetching it once.
		remote=${START_POINT%%/*}
		rest=${START_POINT#*/}
		if [ "$DO_FETCH" -eq 1 ] && [ "$remote" != "$START_POINT" ] \
			&& git remote | grep -Fxq "$remote"; then
			info "start point '$START_POINT' unknown, fetching from $remote..."
			[ "$DRY_RUN" -eq 1 ] || git fetch --quiet "$remote" "$rest" || true
		fi
		resolve "$START_POINT" || die "cannot resolve start point: $START_POINT"
	fi

	IS_REMOTE_REF=0
	git show-ref --verify --quiet "refs/remotes/$START_POINT" && IS_REMOTE_REF=1 || true
fi

# --------------------------------------------------------------- worktrees ---

ALREADY=0
if worktree_registered "$WT_PATH"; then
	ALREADY=1
	warn "worktree already exists: $WT_PATH"
elif [ -e "$WT_PATH" ]; then
	die "path exists but is not a registered worktree: $WT_PATH"
fi

# ------------------------------------------------------------ build command --

ADD_ARGS=()
[ "$FORCE" -eq 0 ] || ADD_ARGS+=(--force)

# Nothing to plan when the worktree is already there: re-running is a no-op
# (and, with --claude, just launches the session again).
if [ "$ALREADY" -eq 0 ]; then
	case $MODE in
		detach)
			ADD_ARGS+=(--detach "$WT_PATH" "$START_POINT")
			;;
		checkout)
			branch_exists "$NAME" || die "not an existing local branch: $NAME (drop --checkout to create one)"
			if [ "$FORCE" -eq 0 ] && branch_in_use "$NAME"; then
				die "branch '$NAME' is already checked out in another worktree (use --force)"
			fi
			ADD_ARGS+=("$WT_PATH" "$NAME")
			;;
		new)
			git check-ref-format --branch "$NAME" >/dev/null 2>&1 \
				|| die "invalid branch name: $NAME"
			if branch_exists "$NAME" && [ "$RESET_BRANCH" -eq 0 ]; then
				if [ "$FORCE" -eq 0 ] && branch_in_use "$NAME"; then
					die "branch '$NAME' is already checked out in another worktree (use --force or -B to reset)"
				fi
				warn "branch '$NAME' already exists; checking it out (base branch '$START_POINT' ignored, use -B to reset it)"
				ADD_ARGS+=("$WT_PATH" "$NAME")
			else
				if [ "$RESET_BRANCH" -eq 1 ]; then
					ADD_ARGS+=(-B "$NAME")
				else
					ADD_ARGS+=(-b "$NAME")
				fi
				[ "$IS_REMOTE_REF" -eq 1 ] && ADD_ARGS+=(--track)
				ADD_ARGS+=("$WT_PATH" "$START_POINT")
			fi
			;;
	esac
fi

# ------------------------------------------------------------------ create ---

if [ "$DRY_RUN" -eq 1 ]; then
	[ "$ALREADY" -eq 1 ] || printf 'git -C %s worktree add %s\n' "$REPO_ROOT" "${ADD_ARGS[*]}"
fi

if [ "$ALREADY" -eq 0 ] && [ "$DRY_RUN" -eq 0 ]; then
	mkdir -p "$(dirname "$WT_PATH")"
	git -C "$REPO_ROOT" worktree add "${ADD_ARGS[@]}"
fi

# Keep the nested worktrees out of `git status` in the main repo.
if [ "$DO_EXCLUDE" -eq 1 ] && [ "$DRY_RUN" -eq 0 ]; then
	if ! git -C "$REPO_ROOT" check-ignore -q "$BASE_DIR/" 2>/dev/null; then
		mkdir -p "$COMMON_DIR/info"
		printf '/%s/\n' "$BASE_DIR" >>"$COMMON_DIR/info/exclude"
		info "added /$BASE_DIR/ to .git/info/exclude"
	fi
fi

if [ "$DRY_RUN" -eq 0 ]; then
	head_desc=$(git -C "$WT_PATH" log -1 --format='%h %s' 2>/dev/null || echo '(no commits)')
	branch_desc=$(git -C "$WT_PATH" symbolic-ref --short -q HEAD || echo "detached @ $(git -C "$WT_PATH" rev-parse --short HEAD)")
	ok "worktree ready: $WT_PATH"
	info "  branch: $branch_desc"
	info "  head:   $head_desc"
fi
printf '%s\n' "$WT_PATH"

# ----------------------------------------------------------------- session ---

[ "$LAUNCH" -eq 1 ] || exit 0
launch_agent "$WT_PATH"
